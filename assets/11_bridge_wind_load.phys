// Bridge wind-load approximation
// Dynamic pressure is converted into lateral load, bending moment, and power transfer.

unit squareMeter = m^2
unit leverMoment = N * m

airDensity = 1.225 kg / m^3
windSpeed = 35 m / s
dragCoefficient = 1.2
exposedArea = 850 squareMeter
leverArm = 18 m

dynamicPressure = 0.5 * airDensity * windSpeed^2
designPressure = dynamicPressure * dragCoefficient
lateralForce = designPressure * exposedArea
bendingMoment = lateralForce * leverArm
windPowerTransfer = lateralForce * windSpeed
momentRatio = bendingMoment / 1000000 leverMoment

print "Dynamic pressure: " + dynamicPressure
print "Design pressure: " + designPressure
print "Lateral force: " + lateralForce
print "Bending moment: " + bendingMoment
print "Wind power transfer: " + windPowerTransfer
print "Moment / 1,000,000 N*m: " + momentRatio
