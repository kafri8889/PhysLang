// Powertrain thermal model
// Torque and rotational speed are converted into mechanical power and heat load.

unit rpm = 1 / 60 s
unit torqueUnit = N * m
unit heatCapacityWater = 4186 J / kg / K

engineTorque = 320 torqueUnit
engineSpeed = 3000 rpm
thermalLossFraction = 0.18
coolantMass = 5 kg
simulationTime = 10 s

mechanicalPower = engineTorque * engineSpeed
heatRate = mechanicalPower * thermalLossFraction
heatEnergy = heatRate * simulationTime
coolantTemperatureRise = heatEnergy / coolantMass / heatCapacityWater

print "Engine speed in SI: " + SI(engineSpeed)
print "Mechanical power: " + mechanicalPower
print "Heat rate: " + heatRate
print "Heat energy: " + heatEnergy
print "Coolant temperature rise: " + coolantTemperatureRise
