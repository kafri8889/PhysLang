// Feature: variable declaration
// Assigning to a new name creates the variable (no 'var' keyword in v2).
// Variables can hold physical quantities or an explicit null.

mass = 12 kg
gravity = 9.8 m / s^2
weight = mass * gravity

// Variable with explicit null
sensorValue = null

// Placeholder that will be filled later
unassigned = null

print "Mass: " + mass
print "Weight: " + weight
print sensorValue
print unassigned
