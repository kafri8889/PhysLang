// Vehicle crash dynamics approximation
// This model estimates momentum, kinetic energy, stopping force, and crush distance.

unit kmh = 1000 m / 3600 s
unit millisecond = 0.001 s

vehicleMass = 1.6 t
impactSpeed = 96 kmh
stoppingTime = 120 millisecond

momentum = vehicleMass * impactSpeed
kineticEnergy = 0.5 * vehicleMass * impactSpeed^2
averageDeceleration = impactSpeed / stoppingTime
averageImpactForce = vehicleMass * averageDeceleration
crushDistance = 0.5 * impactSpeed * stoppingTime
forceRatioToOneKiloNewton = averageImpactForce / 1000 N

print "Impact speed in SI: " + SI(impactSpeed)
print "Momentum: " + momentum
print "Kinetic energy: " + kineticEnergy
print "Average deceleration: " + averageDeceleration
print "Average impact force: " + averageImpactForce
print "Crush distance: " + crushDistance
print "Force / 1000 N: " + forceRatioToOneKiloNewton
