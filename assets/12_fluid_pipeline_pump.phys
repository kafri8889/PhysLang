// Fluid pipeline pump approximation
// Estimates flow velocity, dynamic pressure, pump power, and daily energy.

unit cubicMeterPerSecond = m^3 / s
unit squareMeter = m^2

waterDensity = 1000 kg / m^3
volumeFlow = 2.4 cubicMeterPerSecond
pipeArea = 0.785 squareMeter
pressureLoss = 180000 Pa
operationTime = 24 h

flowVelocity = volumeFlow / pipeArea
dynamicPressure = 0.5 * waterDensity * flowVelocity^2
pumpPower = pressureLoss * volumeFlow
dailyEnergy = pumpPower * operationTime
pressureRatio = dynamicPressure / pressureLoss

print "Flow velocity: " + flowVelocity
print "Dynamic pressure: " + dynamicPressure
print "Pump power: " + pumpPower
print "Daily pump energy: " + dailyEnergy
print "Dynamic pressure / pressure loss: " + pressureRatio
